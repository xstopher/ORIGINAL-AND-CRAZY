{
  "name": "ORIGINAL & CRAZY Streetwear",
  "short_name": "O&C Streetwear",
  "description": "Bold, rebellious fashion and streetwear drops. Nairobi to the world.",
  "start_url": "/",
  "id": "/",
  "scope": "/",
  "display": "fullscreen",
  "display_override": [
    "fullscreen",
    "standalone",
    "minimal-ui",
    "window-controls-overlay"
  ],
  "orientation": "portrait",
  "background_color": "#06040a",
  "theme_color": "#741cff",
  "categories": ["shopping", "lifestyle", "fashion"],
  "icons": [
    {
      "src": "/brand-logo.jpg",
      "sizes": "1024x1024",
      "type": "image/jpeg",
      "purpose": "any maskable"
    },
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/icon.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Shop Drop",
      "url": "/shop",
      "icons": [{ "src": "/brand-logo.jpg", "sizes": "96x96" }]
    },
    {
      "name": "My Account",
      "url": "/login",
      "icons": [{ "src": "/brand-logo.jpg", "sizes": "96x96" }]
    }
  ]
}
